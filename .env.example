SKYLAB_CMS_DB_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:3001
ConnectionStrings__Default=Host=localhost;Port=5432;Database=skylab_cms;Username=skylab_cms;Password=postgres
ConnectionStrings__Redis=localhost:6379,defaultDatabase=0
ACCOUNT_ACCESS_GATE_MODE=off
# Required only when ACCOUNT_ACCESS_GATE_MODE=enforce:
# ACCOUNT_ACCESS_REDIS_ENDPOINT=access-gate-redis:6379
# ACCOUNT_ACCESS_REDIS_USERNAME=cms-reader
# ACCOUNT_ACCESS_REDIS_PASSWORD=replace-me
# ACCOUNT_ACCESS_REDIS_DATABASE=0
# ACCOUNT_ACCESS_REDIS_TLS=true
# Mount these files read-only; never put the private-key PEM in an environment variable.
# ACCOUNT_ACCESS_REDIS_CA_CERT_FILE=/run/secrets/account-access/ca.crt
# ACCOUNT_ACCESS_REDIS_TLS_CERT_FILE=/run/secrets/account-access/cms.crt
# ACCOUNT_ACCESS_REDIS_TLS_KEY_FILE=/run/secrets/account-access/cms.key
# ACCOUNT_ACCESS_REDIS_OPERATION_TIMEOUT_MS=200
# ACCOUNT_ACCESS_GATE_RETRY_AFTER_SECONDS=1
